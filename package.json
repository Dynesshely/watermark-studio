{
  "name": "watermark-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "纯浏览器端图片水印工具：文字/颜色/透明度/间距/角度自定义，平铺与单次两种模式，批量导出与 ZIP 打包",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 50011",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "vite": "^5.4.11"
  }
}
